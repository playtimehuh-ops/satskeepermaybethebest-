# --- Vercel environment variables (Project > Settings > Environment Variables)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # secret: server only, never in the app
APP_KEY=                             # long random string, same value as the APP_KEY GitHub secret
NVIDIA_API_KEY=
BITREFILL_API_KEY=
ADMIN_USER=
ADMIN_PASS=                          # 20+ characters
CRON_SECRET=                         # 16+ random characters; Vercel Cron sends it automatically

# --- Optional safety limits (defaults shown)
MAX_MB_PER_DAY=10000                 # per user, per rolling 24h
VEST_HOURS=24                        # new points cannot be spent for this long
MAX_REDEMPTIONS_PER_USER_DAY=1
MAX_REDEMPTIONS_PER_DAY=20           # whole app, per rolling 24h
MAX_INVOICE_USD=12                   # refuse to pay an invoice above this price
# MAX_CARD_VALUE_JSON={"USD":10,"GBP":8}
# BITREFILL_INCLUDE_TEST=true        # development only: lists free test products
# NIM_MODEL=moonshotai/kimi-k3-instruct
