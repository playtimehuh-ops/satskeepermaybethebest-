<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only, and only certificates from the system store. A user-installed
         CA (the usual way to snoop on an app's traffic) is not trusted. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
