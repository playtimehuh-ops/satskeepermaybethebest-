<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Nothing leaves the device through cloud backup or device-to-device transfer:
         the encrypted login session cannot be restored elsewhere anyway. -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
